{
  "name": "iceberg",
  "version": "0.0.0",
  "private": true,
  "description": "Iceberg — control de cuentas local-first con inteligencia economica",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run web --workspace @iceberg/mobile",
    "postinstall": "patch-package",
    "movil": "npm run start --workspace @iceberg/mobile"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
