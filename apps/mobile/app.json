{
  "expo": {
    "name": "Iceberg",
    "slug": "iceberg",
    "version": "0.11.2",
    "orientation": "portrait",
    "scheme": "iceberg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.nispeter.iceberg",
      "versionCode": 19,
      "backgroundColor": "#0E192A",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E192A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0E192A",
    "icon": "./assets/icon.png"
  }
}
